<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <title>Home</title>
</head>

<body>
    <%- include('partials/header') %>
    <main>
        <section>
            <h1>Welcome to My Website</h1>
            <h2>A simple project built for learning and practice</h2>
            <p>This page shows how Express and EJS can work together to create something clean, reusable, and easy to understand.</p>
            <ul>
                <% users.forEach(user => { %>
                    <li><%= user %></li>
                <% }) %>
            </ul>
        </section>

        <section>
            <div>
                <img src="/images/image.jpg" alt="Website preview" width="300">
            </div>
        </section>
    </main>
    <%- include('partials/footer') %>
    <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
